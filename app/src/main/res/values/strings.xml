<resources>
    <!-- Android-only strings. Everything else is GENERATED from the iOS
         String Catalog into strings_catalog.xml — run tools/generate_strings.py.
         Never add a key here that the catalog already provides. -->
    <string name="app_name">workis</string>
    <string name="jowi_tab">Jowi</string>
    <string name="lang_tr">Türkçe</string>
    <string name="lang_en">English</string>
    <string name="apply_sector_hint">Sector (optional)</string>
    <!-- The gate UNLOCKS a session that is already open; signing in is what a
         passkey does. The catalog's faceIDReason still says "sign in", so the
         prompt takes its own Android-only line. -->
    <string name="bio_title">Unlock Jowi</string>
    <string name="bio_subtitle">Unlock the session open on this device</string>
    <string name="age_minutes">%d min</string>
    <string name="age_hours">%d h</string>
    <!-- the notification channel's name in the system settings (push, ledger 45) -->
    <string name="push_channel_name">Workis notifications</string>
</resources>
